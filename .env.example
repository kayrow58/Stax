# Copy this file to .env.local for local development.
# On Vercel, add these under Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or "Data API") → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key"
# (older projects call it the "anon public" key — either works)
VITE_SUPABASE_KEY=your-publishable-or-anon-key

# Public half of your push-notification keys (from /setup-keys.html)
VITE_VAPID_PUBLIC_KEY=
